@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# A bundled zlib is part of the exported targets
if(NOT @ZXKIT_BUNDLED_ZLIB@)
    find_dependency(ZLIB)
endif()
find_dependency(Threads)
find_dependency(SafeCpp 1.0)

include("${CMAKE_CURRENT_LIST_DIR}/zxkitTargets.cmake")

check_required_components(zxkit)
