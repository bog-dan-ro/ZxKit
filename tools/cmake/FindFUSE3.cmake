find_package(PkgConfig QUIET)
if(PkgConfig_FOUND)
    pkg_check_modules(PC_FUSE3 QUIET IMPORTED_TARGET fuse3>=3.10)
endif()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(FUSE3 REQUIRED_VARS PC_FUSE3_FOUND VERSION_VAR PC_FUSE3_VERSION)
if(FUSE3_FOUND AND NOT TARGET FUSE3::FUSE3)
    add_library(FUSE3::FUSE3 INTERFACE IMPORTED)
    set_target_properties(FUSE3::FUSE3 PROPERTIES INTERFACE_LINK_LIBRARIES PkgConfig::PC_FUSE3)
endif()
